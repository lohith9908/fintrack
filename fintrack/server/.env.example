# ========================================================
# FinTrack Server — Environment Variables Template
# ========================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# In production, specify your secure MongoDB Atlas or Replica Set connection URI
MONGO_URI=mongodb://localhost:27017/fintrack

# Authentication & Security
# Minimum 32 random characters for cryptographic security
JWT_SECRET=fintrack_jwt_secret_key_minimum_32_characters_for_production_security
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=fintrack_cookie_secret_key_for_signing_production_cookies

# Default Administrator Seed Credentials (Idempotent seed)
ADMIN_EMAIL=admin@fintrack.local
ADMIN_PASSWORD=AdminSecurePassword123!

# File Upload Configuration (Multer)
# Max file size in bytes (5 MB = 5242880)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email / SMTP Configuration (Password Recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=FinTrack <noreply@fintrack.local>
