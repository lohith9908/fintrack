# ==========================================
# FinTrack — Environment Variables Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/fintrack

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=your_cookie_secret_key_for_signing_cookies

# Default Admin Seed Credentials (Idempotent seed)
ADMIN_EMAIL=admin@fintrack.local
ADMIN_PASSWORD=AdminSecurePassword123!

# File Upload Configuration (Multer)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email Configuration (Nodemailer / SMTP for Password Recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=FinTrack <noreply@fintrack.local>
